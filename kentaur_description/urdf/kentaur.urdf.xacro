<?xml version="1.0"?>
<robot name="kentaur" xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <xacro:include filename="$(find sleipner_description)/urdf/sleipner.urdf" />
  <xacro:include filename="$(find yumift_description)/urdf/yumift.urdf" />

  <!--yumi-->
  <!-- <xacro:yumi 
    name="yumi" 
    hardware_interface="hardware_interface/VelocityJointInterface"
    grippers_interface="hardware_interface/EffortJointInterface"/> -->

  <!-- <joint name="yumi_base_link_to_sleipner" type="fixed">
    <parent link="sleipner"/>
    <child link="yumi_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint> -->
  
<!--   
  <link name="odom">
  </link> -->

  <material name="Kentaur/Ivory">
    <color rgba="1.0 1.0 0.94 1.0"/>
  </material>

  <joint name="footprint_to_surface" type="fixed">
    <parent link="base_footprint" />
    <child link="sleipner_surface" />
    <origin xyz="0 0 0.303" rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="sleipner_surface">
  </link>

  <joint name="surface_to_yumi" type="fixed">
    <parent link="sleipner_surface" />
    <child link="yumi_base_link" />
    <origin xyz="-0.390 0 0.500" rpy="0 0 3.14159265359" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="support_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="25"/>
      <inertia ixx="0.0"  ixy="0"  ixz="0" iyy="0.0" iyz="0" izz="0.0" />
    </inertial>

    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.55 0.50"/>
      </geometry>
      <material name="Kentaur/Ivory" />
    </visual>

    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.55 0.50"/>
      </geometry>
    </collision>
  </link>

  <joint name="surface_to_support" type="fixed">
    <parent link="sleipner_surface" />
    <child link="support_frame" />
    <origin xyz="-0.25 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>

</robot>
