					</horizontal>
				</scan>
				<range>
					<min>0.05</min>
					<max>29.5</max>
					<resolution>0.03</resolution>
				</range>
				<noise>
					<type>gaussian</type>
					<mean>0.0</mean>
					<stddev>0.02</stddev>
				</noise>
			</ray>
			<plugin filename="libgazebo_ros_laser.so" name="gazebo_ros_base_laser_rear_controller">
				<topicName>base_laser_rear/scan_raw</topicName>
				<frameName>base_laser_rear_link</frameName>
			</plugin>
		</sensor>
	</gazebo>
	<!--
 	<xacro:tower_symetric name="tower" parent="base_link">
 		<origin xyz="${tower_x} ${tower_y} ${tower_z}" rpy="${tower_roll} ${tower_pitch} ${tower_yaw}" />
 	</xacro:tower_symetric>
	-->
	<!-- scan top mount -->
	<joint name="base_laser_top_joint" type="fixed">
		<origin rpy="0.0 0.0 0.0" xyz="0.28 0.0 0.885"/>
		<parent link="base_link"/>
		<child link="base_laser_top_link"/>
	</joint>
	<link name="base_laser_top_link">
		<inertial>
			<mass value="0.01"/>
			<origin xyz="0 0 0"/>
			<inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
		</inertial>
		<visual>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			<geometry>
				<box size="0.10 0.03 0.03"/>
			</geometry>
			<material name="IPA/Black"/>
		</visual>
	</link>
	<!-- END: scan top mount -->
</robot>
