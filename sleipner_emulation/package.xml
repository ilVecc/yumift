<?xml version="1.0"?>
<package format="2">
  <name>sleipner_emulation</name>
  <version>0.2.0</version>
  <description>
    Hardware emulation of the Sleipner robot. 
    Major parts of the package are reimplemented/copied from the original IPA packages.
  </description>
  
  <maintainer email="sebastiano.fregnan@control.lth.se">Sebastiano Fregnan</maintainer>
  <license>MIT</license>

  <url type="repository">http://github.com/ilVecc/yumift</url>
  <author email="sebastiano.fregnan@control.lth.se">Sebastiano Fregnan</author>

  <buildtool_depend>catkin</buildtool_depend>
  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- Python dependencies -->
  <exec_depend>python3-numpy</exec_depend>

  <!-- <exec_depend>control_msgs</exec_depend>
  <exec_depend>move_base_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf_conversions</exec_depend>
  <exec_depend>tf2_ros</exec_depend> -->

</package>
